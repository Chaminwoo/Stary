# fastlane — TestFlight/App Store 업로드 자동화.
# CI(macOS)에서 호출. 인증은 App Store Connect API Key(.p8) 사용 → 비밀번호/2FA 불필요.
#
# 필요한 환경변수(GitHub Secrets → CI env):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT(.p8 내용), DEVELOPMENT_TEAM
default_platform(:ios)

XCODEPROJ = "Stary.xcodeproj"
SCHEME    = "Stary"

platform :ios do
  before_all do
    # XcodeGen 으로 .xcodeproj 생성(레포에 커밋 안 함)
    sh("which xcodegen >/dev/null 2>&1 || brew install xcodegen")
    sh("cd .. && xcodegen generate")
  end

  desc "TestFlight 업로드 (베타)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    build_app(
      project: "../#{XCODEPROJ}",
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      output_directory: "../build",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "App Store 심사 제출(메타데이터 제외, 빌드만)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )
    build_app(
      project: "../#{XCODEPROJ}",
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      output_directory: "../build",
    )
    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end
end
