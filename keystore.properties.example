# 릴리즈 서명 정보 템플릿.
# 이 파일을 복사해 프로젝트 루트에 keystore.properties 로 저장하고 실제 값을 채운다.
#   (keystore.properties / *.jks 는 .gitignore 로 커밋 제외됨 — 절대 커밋 금지)
#
# 1) keystore 생성 (비밀번호는 직접 입력):
#    keytool -genkeypair -v -keystore stary-release.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias stary
# 2) 아래 값 채우기. STORE_FILE 은 프로젝트 루트 기준 상대경로.
# 3) 생성된 keystore 의 SHA-1 을 Firebase 콘솔(momentdiary-f26c8)에 등록해야
#    릴리즈 빌드에서 Google 로그인이 동작한다:
#    keytool -list -v -keystore stary-release.jks -alias stary

STORE_FILE=stary-release.jks
STORE_PASSWORD=여기에_keystore_비밀번호
KEY_ALIAS=stary
KEY_PASSWORD=여기에_키_비밀번호
