<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 햅틱(진동) 피드백 — 별 탭/파장/좋아요/업적. 런타임 요청이 없는 일반 권한. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 인스타그램 스토리 직접 공유(ADD_TO_STORY) 대상 앱 가시성(Android 11+ 패키지 쿼리 제한) -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:name=".StaryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_image"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_image"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stary">

        <!-- 지도는 MapLibre + MapTiler 벡터 타일 사용. 키는 BuildConfig.MAPTILER_KEY 로 주입
             (Google Maps geo API_KEY 메타데이터 불필요). -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Stary"
            android:windowSoftInputMode="adjustResize">
            <!-- Android 16(API 36)+ 는 **sw600dp 이상 화면**에서 screenOrientation/크기조절 제한을
                 무시한다 → 태블릿·펼친 폴더블에서 이 앱이 가로로 열린다.
                 이 앱 UI 는 세로 전제로 구성돼(로그인 인트로 영상, 지구본, 별 배치, 하단 내비)
                 가로에서 레이아웃이 깨지므로 임시 opt-out 으로 세로 고정을 유지한다.
                 ⚠️ **유예이지 면제가 아니다** — targetSdk 37 부터는 이 property 가 무시된다.
                    그전에 대형 화면(가로) 레이아웃 대응이 필요하다.
                 ※ 일반 폰(sw600dp 미만)은 이 변경과 무관하게 원래대로 세로 고정. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 공유 웹 랜딩 → 앱 딥링크 (stary://diary/{diaryId} = 별 지도 포커스,
                 stary://invite/{inviterUid} = 친구 초대 리딤. 체크리스트 30/31) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="diary"
                    android:scheme="stary" />
                <data
                    android:host="invite"
                    android:scheme="stary" />
            </intent-filter>
            <!-- App Links(https) — 카톡/문자 등에서 공유 링크를 누르면 웹 랜딩을 거치지 않고
                 앱이 바로 열린다. autoVerify 를 켜면 시스템이 설치 시
                 https://{host}/.well-known/assetlinks.json 의 SHA-256 지문과 앱 서명을 대조해 검증한다.
                 ⚠️ Play 앱 서명 키 지문이 그 파일에 들어 있어야 Play 설치본에서 동작한다.
                 호스트/경로는 StaryConfig.SHARE_HOST / SHARE_PATH_* 와 동일해야 한다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="momentdiary-f26c8.web.app"
                    android:pathPrefix="/s/"
                    android:scheme="https" />
                <data
                    android:host="momentdiary-f26c8.web.app"
                    android:pathPrefix="/i/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 채널 id 없이 도착한 메시지의 기본 채널 — 없으면 시스템이 '기타(Miscellaneous)' 저중요도
             채널에 넣어 상단 배너가 안 뜬다. 서버는 보통 channelId 를 함께 보낸다(ANDROID_OPTS). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="stary_default" />

        <!-- FCM 수신 (푸시 발송은 Cloud Functions 필요 — 체크리스트 7/8) -->
        <service
            android:name=".push.StaryMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>