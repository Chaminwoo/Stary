<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+(API 31) 시스템 스플래시 — 완전 검정 배경만 보이도록.
         배경=검정, 아이콘은 투명 드로어블로 대체해 숨긴다(아이콘 없이 검정 화면만).
         ⚠️ values/themes.xml 의 다크 고정 항목(windowLight*Bar / forceDarkAllowed)을 여기에도
            그대로 복제해야 한다 — 이 파일이 같은 이름의 스타일을 **통째로 대체**하기 때문. -->
    <style name="Theme.Stary" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
    </style>
</resources>
