rules_version = '2';

// Stary Storage 보안 규칙
// - 읽기: 누구나(다이어리/프로필 이미지는 다른 사용자에게도 보여야 함).
// - 쓰기: 로그인(익명 포함) 세션이 있어야 하고, 이미지 + 용량 제한.
//
// ⚠️ 경로의 userId 는 Google sub(JWT subject)라 Firebase Auth uid 와 다르다.
//    따라서 profile_images 쓰기에 request.auth.uid == userId 를 쓰면 항상 거부된다.
//    여기서는 "로그인된 세션이면 허용"으로 둔다.
//
// 배포: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    match /diary_images/{imageId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    match /profile_images/{imageId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    // 그 외 경로는 모두 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
