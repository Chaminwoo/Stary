# 이 파일을 복사해서 secrets.properties 로 저장한 뒤 실제 값을 채운다.
#   copy secrets.properties.example secrets.properties   (Windows)
#   cp   secrets.properties.example secrets.properties   (macOS/Linux)
#
# secrets.properties 는 .gitignore 에 의해 추적되지 않는다. 절대 커밋하지 말 것.

# Google Cloud Console > APIs & Services > Credentials 에서 발급한
# Maps SDK for Android 용 API Key
MAPS_API_KEY=TODO_ADD_YOUR_GOOGLE_MAPS_API_KEY

# Firebase Console > 프로젝트 설정 > 웹 OAuth 클라이언트(client_type 3) 의 client_id
# (Google 로그인 ID 토큰 발급에 사용. google-services.json 의 oauth_client 와 동일)
GOOGLE_WEB_CLIENT_ID=TODO_ADD_GOOGLE_WEB_CLIENT_ID
