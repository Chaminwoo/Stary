rules_version = '2';

// Stary Firestore 보안 규칙 (named DB: stary-db) — Stage 2 (firestore.rules 에서 tools/rules-test/build-stage2.js 로 생성)
//
// ─────────────────────────────────────────────────────────────────────────────
// [보안 모델 — 편집 전 반드시 읽을 것]
//  1) 로그인은 Google · Apple 또는 이메일/비밀번호(심사용 계정)뿐이다.
//     isSignedIn() 은 토큰의 sign_in_provider 가 이 셋 중 하나일 때만 참이다.
//     그 밖의 세션(익명·커스텀 등)은 어떤 읽기·쓰기도 할 수 없다(공개 설정 문서 포함, 예외 없음).
//  2) 앱의 userId(= "appUserId")는 다음 규칙으로 정해진다(Android GoogleAuthHelper / iOS AuthManager 동일):
//       - Google 로그인: **Google sub**(JWT subject)  = request.auth.token.firebase.identities['google.com'][0]
//       - Apple · 이메일: **FirebaseAuth uid**          = request.auth.uid
//     이 값은 모두 규칙 안에서 위조 불가능한 토큰 클레임으로 읽을 수 있다.
//     → 소유가 필요한 쓰기는 isMe(문서의 소유자 필드) 로 "이 값이 나 자신인지"를 강제한다.
//  3) 문서를 만들거나 고칠 때는 허용 키 · 타입 · 길이 · 범위를 규칙이 확인한다. 한도는 앱의 입력 제한
//     (StaryConfig.*_MAX_LEN / AppConfig)보다 넉넉하게 잡아 정상 사용이 막히지 않게 했다.
//  4) 규칙으로 표현하기 어려운 제한(작성 빈도, 번역·푸시 비용 등)은 서버(functions)가 맡는다.
//  5) 서버 전용 컬렉션(rateLimits · abuseLog)은 아래 마지막 규칙(기본 거부)으로 클라이언트가 접근할 수 없다.
//
// 이 파일은 Stage 2 다 — 문서별 열람 범위를 읽기 규칙으로 강제한다. 새 앱(versionCode ≥ 35)이 퍼진 뒤,
// 백필(tools/security/backfill.js)을 마치고 배포한다. Stage 1 과의 차이는 [STAGE2] 표시가 붙은 세 곳뿐.
// ⚠️ 이 파일을 직접 고치지 말고 firestore.rules 를 고친 뒤 `node tools/rules-test/build-stage2.js` 로 다시 만들 것.
//
// 배포(named DB 지정 필수): firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 세션인가 — 허용 provider 는 google.com / apple.com / password 뿐.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com', 'password'];
    }

    // 주어진 appUserId 가 "나 자신"인지 — Google 은 sub, 그 외는 FirebaseAuth uid.
    // ⚠️ '||' 단락 평가로 Google 이 아닌 세션에서 identities['google.com'] 접근 에러를 피한다.
    function isMe(appId) {
      return isSignedIn() && (
        appId == request.auth.uid
        || (request.auth.token.firebase.sign_in_provider == 'google.com'
            && appId == request.auth.token.firebase.identities['google.com'][0])
      );
    }

    // 내 appUserId — isSignedIn() 통과 뒤에만 호출할 것.
    function myAppUserId() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        ? request.auth.token.firebase.identities['google.com'][0]
        : request.auth.uid;
    }

    // ── 공통 검증 도우미 ─────────────────────────────────────────────────────
    // 키가 없으면 통과, 있으면 문자열이고 max 자 이하.
    function strOk(d, f, max) {
      return !(f in d) || (d[f] is string && d[f].size() <= max);
    }

    // 키가 없으면 통과, 있으면 정수이고 lo..hi.
    function intOk(d, f, lo, hi) {
      return !(f in d) || (d[f] is int && d[f] >= lo && d[f] <= hi);
    }

    // 클라이언트 시각이 "지금 + 1시간" 을 넘지 않는 양의 정수(epoch ms). 과거는 오프라인 대기 저장 때문에 허용.
    function timeOk(v) {
      return v is int && v > 0 && v <= request.time.toMillis() + 3600000;
    }

    // 이 프로젝트의 Storage 다운로드 URL 이거나 빈 값(키가 없어도 통과).
    function mediaUrlOk(d, f) {
      return !(f in d) || (d[f] is string && (d[f] == '' || (
        d[f].size() <= 1500
        && d[f].matches('https://firebasestorage[.]googleapis[.]com/v0/b/momentdiary-f26c8[.](firebasestorage[.]app|appspot[.]com)/o/diary_(images|videos)%2F[A-Za-z0-9_-]+[.][A-Za-z0-9]+[?].*')
      )));
    }

    // ── 1:1 채팅 ──────────────────────────────────────────────────────────────
    // ⚠️ **두 가지 판정을 용도별로 섞어 써야 한다. 하나로 통일하면 반드시 한쪽이 깨진다.**
    //
    //  (A) chatId 로 판정 — `isChatMember(chatId)`
    //      chatId = 두 appUserId 를 정렬·결합한 결정적 값("작은id_큰id", StaryConfig.chatId /
    //      AppConfig.chatId)이라 그 안에 내 id 가 있으면 곧 참여자다.
    //      → **방 문서가 아직 없는 첫 메시지**에도 쓸 수 있다(resource/get 이 null 이어도 판정 가능).
    //      과거 messages 규칙이 `get(chats/{chatId}).data.participants` 를 봐서, 방이 없는 첫 메시지가
    //      항상 거부됐다 = 새 상대(iOS ↔ Android)와 채팅이 영영 안 되던 원인.
    //
    //  (B) participants 필드로 판정 — `myAppUserId() in resource.data.participants`
    //      **컬렉션 쿼리(list)** 에 필요하다. 친구 화면/인앱 배너는
    //      `chats.whereArrayContains("participants", 내id)` 로 방 목록을 구독하는데,
    //      이 쿼리는 "결과 문서의 **문서 id** 안에 내 id 가 들어 있다"는 걸 규칙 엔진이 증명할 수 없다
    //      → (A)만 쓰면 **쿼리 전체가 거부**되어 마지막 메시지가 안 보인다("아직 채팅이 없어요").
    //      쿼리 제약(participants arrayContains 나)과 규칙 조건이 같은 형태여야 통과한다.
    //
    //  정리: 방 문서 읽기/수정·목록 쿼리 = (B), 방 문서 생성 + messages 하위 = (A).
    function isChatMember(chatId) {
      return isSignedIn() && myAppUserId() in chatId.split('_');
    }

    match /chats/{chatId} {
      // 방 메타에 쓰는 키(앱은 이 여섯 개만 쓴다).
      function chatKeys() {
        return ['participants', 'lastMessage', 'lastSenderId', 'lastSenderName', 'updatedAt', 'lastReadAt'];
      }

      // 목록 쿼리(participants arrayContains 나)가 통과하려면 반드시 이 형태여야 한다. (B)
      allow read: if isSignedIn() && myAppUserId() in resource.data.participants;

      // 첫 메시지에서 방을 만드는 경우 — resource 가 없으므로 chatId + 새로 쓰는 participants 로 판정. (A)
      // participants 는 chatId 를 "_" 로 나눈 두 사람과 정확히 같아야 한다.
      allow create: if isChatMember(chatId)
        && request.resource.data.keys().hasOnly(chatKeys())
        && request.resource.data.keys().hasAll(['participants'])
        && request.resource.data.participants == chatId.split('_')
        && request.resource.data.participants.size() == 2
        && strOk(request.resource.data, 'lastMessage', 1000)
        && strOk(request.resource.data, 'lastSenderId', 128)
        && strOk(request.resource.data, 'lastSenderName', 100)
        && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == myAppUserId())
        && (!('updatedAt' in request.resource.data) || timeOk(request.resource.data.updatedAt))
        && (!('lastReadAt' in request.resource.data) || request.resource.data.lastReadAt is map);

      // 마지막 메시지/읽음 시각 갱신 — 기존 문서 기준. (B) participants 는 바꿀 수 없다.
      allow update: if isSignedIn() && myAppUserId() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastSenderId', 'lastSenderName', 'updatedAt', 'lastReadAt'])
        && strOk(request.resource.data, 'lastMessage', 1000)
        && strOk(request.resource.data, 'lastSenderId', 128)
        && strOk(request.resource.data, 'lastSenderName', 100)
        && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == myAppUserId())
        && (!('updatedAt' in request.resource.data) || timeOk(request.resource.data.updatedAt))
        && (!('lastReadAt' in request.resource.data) || request.resource.data.lastReadAt is map);

      // 방 삭제 기능은 없지만, 참여자 본인 정리는 막지 않는다(구 규칙과 동일 범위).
      allow delete: if isSignedIn() && myAppUserId() in resource.data.participants;

      match /messages/{messageId} {
        // 하위 컬렉션은 경로에 chatId 가 이미 확정돼 있어 (A) 로 충분하다.
        // 방 문서 존재 여부와 무관해야 하므로 get() 을 쓰지 않는다(읽기 비용도 절약).
        allow read: if isChatMember(chatId);

        // 앱 입력 제한 500자 — 규칙은 1000자까지. senderId 는 반드시 나.
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['id', 'senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == myAppUserId()
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && strOk(request.resource.data, 'senderName', 100)
          && strOk(request.resource.data, 'id', 64)
          && timeOk(request.resource.data.createdAt);

        allow update: if false;

        allow delete: if isChatMember(chatId)
          && resource.data.senderId == myAppUserId()
          && request.time.toMillis() - resource.data.createdAt < 60000;
      }
    }

    // ── 다이어리 ────────────────────────────────────────────────────────────
    //  읽기 : 문서별 공개 범위(아래 get / list 규칙).
    //  생성 : userId 는 나 자신, 키 · 타입 · 길이 · 범위 검증, 카운터는 0, 번역(translations) · 대상 목록(audience)은 서버만 쓴다
    //         (Android 는 translations=null 을 함께 쓰므로 null 은 허용).
    //  수정 : 소유자=본문 · 공개 범위 · 표시 정보만(userId 불변, 카운터는 늘릴 수 없음)
    //         / 비소유자=카운터(좋아요·댓글·조회수)만, 한 번에 ±1(조회수는 +1)만.
    //  삭제 : 소유자만(신고 조치 삭제는 서버 Admin SDK 가 규칙을 우회한다).
    match /diaries/{diaryId} {
      // 앱이 쓰는 키 전체(Android · iOS · 구버전 포함). audience · translations 는 서버 전용이라 생성 키에서 뺀다.
      function diaryKeys() {
        return ['id', 'userId', 'userName', 'anonymous', 'isAnonymous', 'title', 'content', 'imageUrl', 'videoUrl',
                'latitude', 'longitude', 'createdAt', 'likeCount', 'commentCount', 'viewCount',
                'starType', 'starColor', 'starPath', 'starColors', 'visibilityType', 'ring'];
      }

      // 본문 · 표시 필드의 타입/길이/범위 검증(생성 · 소유자 수정 공통).
      function diaryFieldsOk(d) {
        return d.title is string && d.title.size() <= 100
          && d.content is string && d.content.size() <= 4000
          && strOk(d, 'userName', 100)
          && strOk(d, 'starPath', 4000)
          && strOk(d, 'ring', 64)
          && strOk(d, 'id', 64)
          && mediaUrlOk(d, 'imageUrl')
          && mediaUrlOk(d, 'videoUrl')
          && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
          && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
          && timeOk(d.createdAt)
          && intOk(d, 'starType', 0, 9999)
          && intOk(d, 'starColor', 0, 9999)
          && (!('starColors' in d) || (d.starColors is list && d.starColors.size() <= 3 && d.starColors.join(',').size() <= 40))
          && (!('visibilityType' in d) || d.visibilityType in ['public', 'friends', 'private'])
          && (!('anonymous' in d) || d.anonymous is bool || d.anonymous is int)
          && (!('isAnonymous' in d) || d.isAnonymous is bool || d.isAnonymous is int);
      }

      // 소유자 수정 — 카운터는 같거나 줄이기만(정상 경로의 증감은 아래 비소유자 분기를 쓴다).
      // audience · translations 는 값을 바꾸거나 새로 넣을 수 없다(지우는 것은 허용 — 서버 트리거가 복구).
      function ownerEdit() {
        let n = request.resource.data;
        let o = resource.data;
        return isMe(o.userId)
          && n.userId == o.userId
          && n.diff(o).affectedKeys().hasOnly(diaryKeys().concat(['audience', 'translations']))
          && diaryFieldsOk(n)
          && n.get('likeCount', 0) <= o.get('likeCount', 0)
          && n.get('commentCount', 0) <= o.get('commentCount', 0)
          && n.get('viewCount', 0) <= o.get('viewCount', 0)
          && (!('audience' in n) || ('audience' in o && n.audience == o.audience))
          && (!('translations' in n) || n.translations == null || ('translations' in o && n.translations == o.translations));
      }

      // 카운터 한 칸 — 그대로이거나 +1, allowDown 이면 -1 도(좋아요 취소·댓글 삭제). 앱은 모두 FieldValue.increment(±1).
      function counterStep(field, allowDown) {
        let before = resource.data.get(field, 0);
        let after = request.resource.data.get(field, 0);
        return after == before || after == before + 1 || (allowDown && after == before - 1);
      }

      // [STAGE2] 읽기 규칙 시작
      // 문서별 공개 범위를 읽기 규칙이 강제한다.
      //  - 단건(get): 전체 공개 / 본인 / 대상 목록(audience)에 포함 / 글쓴이의 친구 목록에 내가 있음.
      //  - 목록(list): 쿼리가 규칙 조건과 같은 형태여야 통과한다(공개 · 내 글 · audience array-contains 나).
      //    visibilityType 이 없는 옛 문서는 백필(tools/security/backfill.js) 전까지 공개 쿼리에 잡히지 않는다.
      allow get: if isSignedIn()
        && (resource.data.get('visibilityType', 'public') == 'public'
            || isMe(resource.data.userId)
            || myAppUserId() in resource.data.get('audience', [])
            || exists(/databases/$(database)/documents/users/$(resource.data.userId)/friends/$(myAppUserId())));
      allow list: if isSignedIn()
        && (resource.data.visibilityType == 'public'
            || isMe(resource.data.userId)
            || myAppUserId() in resource.data.audience);
      // [STAGE2] 읽기 규칙 끝

      allow create: if isMe(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(diaryKeys().concat(['translations']))
        && request.resource.data.keys().hasAll(['userId', 'title', 'content', 'latitude', 'longitude', 'createdAt'])
        && request.resource.data.get('translations', null) == null
        && diaryFieldsOk(request.resource.data)
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('viewCount', 0) == 0
        && (!('id' in request.resource.data) || request.resource.data.id == diaryId);

      allow update: if ownerEdit()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likeCount', 'commentCount', 'viewCount'])
            && counterStep('likeCount', true)
            && counterStep('commentCount', true)
            && counterStep('viewCount', false));

      allow delete: if isMe(resource.data.userId);

      // 댓글: 작성자(userId)만 생성, 삭제는 작성자 또는 글주인. 앱 입력 제한 300자 — 규칙은 1000자까지.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isMe(request.resource.data.userId)
          && request.resource.data.keys().hasOnly(['id', 'diaryId', 'userId', 'userName', 'content', 'createdAt'])
          && request.resource.data.keys().hasAll(['userId', 'content', 'createdAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 1000
          && strOk(request.resource.data, 'userName', 100)
          && strOk(request.resource.data, 'id', 64)
          && (!('diaryId' in request.resource.data) || request.resource.data.diaryId == diaryId)
          && timeOk(request.resource.data.createdAt);
        allow update: if false;
        allow delete: if isMe(resource.data.userId)
          || isMe(get(/databases/$(database)/documents/diaries/$(diaryId)).data.userId);
      }

      // 좋아요: 문서 id = 좋아요 누른 사람 appUserId → 본인 것만 생성/삭제.
      match /likes/{likeUserId} {
        allow read: if isSignedIn();
        allow create, update: if isMe(likeUserId)
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'createdAt'])
          && strOk(request.resource.data, 'userId', 128)
          && strOk(request.resource.data, 'userName', 100)
          && timeOk(request.resource.data.get('createdAt', 0));
        allow delete: if isMe(likeUserId);
      }
    }

    // ── 알림 ────────────────────────────────────────────────────────────────
    //  생성 : 행위자(actorId) 본인만(남 명의 알림 위조 금지), 종류는 아래 네 가지뿐.
    //  읽기/삭제 : 수신자(diaryOwnerId) 본인만. 수정 : 수신자가 읽음 표시(read)만.
    //  (첫 별 공지 FIRST_STAR 는 알림 문서가 아니라 서버가 쓰는 firstStars 에서 온다.)
    match /notifications/{notificationId} {
      allow read:   if isMe(resource.data.diaryOwnerId);
      allow create: if isMe(request.resource.data.actorId)
        && request.resource.data.keys().hasOnly(['id', 'type', 'diaryId', 'diaryTitle', 'diaryOwnerId', 'actorId',
                                                  'actorName', 'content', 'createdAt', 'read'])
        && request.resource.data.keys().hasAll(['type', 'diaryOwnerId', 'actorId', 'createdAt'])
        && request.resource.data.type in ['LIKE', 'COMMENT', 'FRIEND_POST', 'FRIEND_REQUEST']
        && request.resource.data.diaryOwnerId is string
        && request.resource.data.diaryOwnerId.size() >= 1
        && request.resource.data.diaryOwnerId.size() <= 128
        && strOk(request.resource.data, 'id', 64)
        && strOk(request.resource.data, 'diaryId', 64)
        && strOk(request.resource.data, 'diaryTitle', 200)
        && strOk(request.resource.data, 'actorName', 100)
        && strOk(request.resource.data, 'content', 1000)
        && request.resource.data.get('read', false) == false
        && timeOk(request.resource.data.createdAt);
      allow update: if isMe(resource.data.diaryOwnerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isMe(resource.data.diaryOwnerId);
    }

    // ── 사용자 공개 프로필 ──────────────────────────────────────────────────
    //  읽기 : 로그인 세션(이름/사진 검색·표시).
    //  쓰기 : 본인 문서만 → fcmToken/authUid/deletionRequestedAt/닉네임/핀 등 민감 필드를 남이 못 바꾸게.
    //         필드가 많고 merge 로 쌓이므로 키 목록은 고정하지 않고 이름 · 사진 URL 의 타입/길이만 본다.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isMe(userId)
        && strOk(request.resource.data, 'userName', 200)
        && strOk(request.resource.data, 'profileImageUrl', 2000);
      allow delete: if isMe(userId);

      // 친구(수락된 양방향 문서): 내 목록이거나(userId==나), 내가 상대 목록에 나를 추가/삭제할 때만(friendId==나).
      match /friends/{friendId} {
        allow read: if isSignedIn();
        // [STAGE2] friends 쓰기 시작
        // 내 목록은 내가 쓴다. 상대 목록에 나를 넣는 것(수락)은 그 상대가 나에게 보낸 요청이 있을 때만.
        allow create: if (isMe(userId)
                          || (isMe(friendId)
                              && exists(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId))))
          && strOk(request.resource.data, 'userName', 200)
          && strOk(request.resource.data, 'photoUrl', 2000);
        allow update: if (isMe(userId) || isMe(friendId))
          && strOk(request.resource.data, 'userName', 200)
          && strOk(request.resource.data, 'photoUrl', 2000);
        allow delete: if isMe(userId) || isMe(friendId);
        // [STAGE2] friends 쓰기 끝
      }

      // 기기별 푸시 토큰(문서 id = FCM 토큰). 본인만 읽고 쓴다 —
      // 남이 읽으면 알림을 가로챌 수 있고, 남이 쓰면 엉뚱한 기기로 알림을 보낼 수 있다.
      // (서버 Cloud Functions 는 Admin SDK 라 규칙을 우회한다.)
      match /fcmTokens/{token} {
        allow read, write: if isMe(userId);
      }

      // 열람 기록·차단 목록: 본인 것만.
      match /viewedDiaries/{viewedId} {
        allow read, write: if isMe(userId);
      }
      match /blocked/{blockedId} {
        allow read, write: if isMe(userId);
      }

      // 채팅 "나에게서만 삭제"(문서 id = chatId, 2026-10-07): 숨긴 메시지 id / 대화 삭제 시점 / 미리보기 대체값.
      // 본인 것만 — 상대가 내가 무엇을 지웠는지 읽을 수 없어야 한다(그래서 공용 chats 문서가 아니라 여기에 둔다).
      match /chatHidden/{chatId} {
        allow read, write: if isMe(userId);
      }

      // 별가루 요청(2026-10-22, 우주 항해·광고 보상·상자 환급 2026-10-26): 본인이 { op, 인자, status:'pending' } 으로
      // 만들기만 하고, 처리 결과는 서버(functions/starlight.js onStarlightOp)가 같은 문서에 쓴다. 수정/삭제 불가 — 결과를 위조하지 못하게.
      match /starlightOps/{opId} {
        allow read: if isMe(userId);
        allow create: if isMe(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().size() <= 16
          && request.resource.data.op in ['claimQuest', 'claimBonus', 'exchange', 'openBox', 'voyage', 'adReward',
                                          'convertBoxes', 'useItem', 'equip'];
        allow update, delete: if false;
      }
    }

    // ── 별빛 공방 지갑(2026-10-22) ─────────────────────────────────────────
    //  문서 id = appUserId. 별가루·옛 성운 상자·뽑은 아이템·광고 보상 횟수. 본인만 읽고, 쓰기는 서버(onStarlightOp)만 —
    //  users 문서 필드로 두면 본인이 마음대로 늘릴 수 있어서 따로 둔다(adFree 와 같은 이유).
    match /wallets/{userId} {
      allow read: if isMe(userId);
      allow write: if false;
    }

    // ── 별빛 공방 뽑기 풀·설정 — 앱 업데이트 없이 늘리고 확률을 바꾸려고 DB 에 둔다(tools/starlight/seed.js). ──
    match /starlightItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /starlightConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // 장착(프레임·배지·오라·칭호) — 서버(equip)가 소유를 확인하고 쓴다. 남의 프로필·지도 오라를 그리려고 모두 읽는다.
    match /starlightEquips/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // 히든 업적 단서 — 서버만(망원경을 쓴 사람의 지갑에 문구가 복사된다). 읽기를 열면 망원경 없이 다 읽어 간다.
    match /starlightHints/{achievementId} {
      allow read, write: if false;
    }

    // ── 친구 요청(pending) ──────────────────────────────────────────────────
    //  생성 : 보낸 사람(fromId) 본인만, 자기 자신에게는 불가. 읽기/삭제 : 당사자(from/to)만. 수정 없음.
    match /friendRequests/{requestId} {
      allow read: if isMe(resource.data.fromId) || isMe(resource.data.toId);
      // [STAGE2] friendRequests 생성 시작
      allow create: if isMe(request.resource.data.fromId)
        && requestId == request.resource.data.fromId + '_' + request.resource.data.toId
        && request.resource.data.keys().hasOnly(['id', 'fromId', 'fromName', 'fromPhotoUrl', 'toId', 'toName', 'createdAt'])
        && request.resource.data.keys().hasAll(['fromId', 'toId'])
        && request.resource.data.toId is string
        && request.resource.data.toId.size() >= 1
        && request.resource.data.toId.size() <= 128
        && request.resource.data.toId != request.resource.data.fromId
        && strOk(request.resource.data, 'id', 64)
        && strOk(request.resource.data, 'fromName', 200)
        && strOk(request.resource.data, 'fromPhotoUrl', 2000)
        && strOk(request.resource.data, 'toName', 200)
        && (!('createdAt' in request.resource.data) || timeOk(request.resource.data.createdAt));
      // [STAGE2] friendRequests 생성 끝
      allow update: if false;
      allow delete: if isMe(resource.data.fromId) || isMe(resource.data.toId);
    }

    // ── 신고 ────────────────────────────────────────────────────────────────
    //  생성만 허용. reporterId 는 나 자신. 내용은 비공개(서버/관리자 Console 에서만 조회·처리 — onReportAction).
    //  검토용 스냅샷(targetTitle/targetContent/…)은 길이만 본다.
    match /reports/{reportId} {
      allow create: if isMe(request.resource.data.reporterId)
        && request.resource.data.type in ['diary', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100
        && request.resource.data.get('status', 'open') == 'open'
        && strOk(request.resource.data, 'targetOwnerId', 200)
        && strOk(request.resource.data, 'targetTitle', 200)
        && strOk(request.resource.data, 'targetContent', 1000)
        && strOk(request.resource.data, 'targetOwnerName', 200)
        && strOk(request.resource.data, 'targetImageUrl', 2000)
        && strOk(request.resource.data, 'reasonDetail', 500)
        && strOk(request.resource.data, 'source', 50)
        && strOk(request.resource.data, 'diaryId', 200)
        && request.resource.data.keys().size() <= 20;
      allow read, update, delete: if false;
    }

    // ── 의견 보내기(2026-11-02, 설정 > 고칠 점 보내기 · 평점 요청 카드) ─────────────────
    //  생성만. uid 는 반드시 나 자신(appUserId — Google 은 sub, Apple · 이메일은 FirebaseAuth uid; users/{uid} 와 같은 규칙).
    //  message 는 1~2000자 문자열, 허용 키는 아래 6개뿐(이름·이메일 등 다른 필드 금지).
    //  읽기/수정/삭제는 모두 불가 — 운영자가 Firebase Console 에서만 본다.
    match /feedback/{feedbackId} {
      allow create: if isMe(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'message', 'platform', 'appVersion', 'locale', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'message', 'platform', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.platform in ['android', 'ios']
        && (!('appVersion' in request.resource.data) || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 64))
        && (!('locale' in request.resource.data) || (request.resource.data.locale is string && request.resource.data.locale.size() <= 16))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ── 히든 업적 선점(앱 전체 1명) ─────────────────────────────────────────
    //  생성 : 본인 명의(achieverId==나)로만(거짓 귀속 방지).
    //  수정 : 불가(도용/덮어쓰기 방지 — 선착순 트랜잭션은 read+create 만 사용).
    //  삭제 : 본인 선점만(어드민이 자기 선점을 풀어 슬롯을 되돌리는 자가치유 — releaseOwnedBy).
    match /hiddenAchievements/{achievementId} {
      allow read: if isSignedIn();
      allow create: if isMe(request.resource.data.achieverId)
        && strOk(request.resource.data, 'achieverName', 200)
        && request.resource.data.keys().size() <= 10;
      allow update: if false;
      allow delete: if isMe(resource.data.achieverId);
    }

    // ── 주간 개척 퀘스트 선점(전 세계 1명) ──────────────────────────────────
    //  생성만(선착순, 이미 있으면 create 실패 = 서버 강제) + 본인 명의. 수정/삭제 불가.
    match /pioneerClaims/{countryCode} {
      allow read: if isSignedIn();
      allow create: if isMe(request.resource.data.userId)
        && countryCode.size() <= 16
        && strOk(request.resource.data, 'userName', 200)
        && request.resource.data.keys().size() <= 10;
      allow update, delete: if false;
    }

    // ── 친구 초대 리딤(문서 id = 리딤한 사람 appUserId, 계정당 1회) ──────────
    //  생성만. 문서 id·redeemerId = 나 자신이어야 하고, 자기 자신 초대(inviterId==나)는 금지.
    match /invites/{redeemerId} {
      allow read: if isSignedIn();
      allow create: if isMe(redeemerId)
        && request.resource.data.redeemerId == redeemerId
        && !isMe(request.resource.data.inviterId)
        && request.resource.data.inviterId is string
        && request.resource.data.inviterId.size() <= 128
        && request.resource.data.keys().size() <= 10;
      allow update, delete: if false;
    }

    // ── 광고제거 계정(2026-10-02) ──────────────────────────────────────────
    //  문서 id = appUserId. 문서가 있으면 100m 밖 게시물을 광고 없이 바로 연다(AdFreeAccount).
    //  본인만 읽고, 쓰기는 Firebase Console/Admin SDK 만 — 사용자가 스스로 켤 수 없게(users 필드로 두지 않은 이유).
    match /adFree/{userId} {
      allow read: if isMe(userId);
      allow write: if false;
    }

    // ── 첫 별 공지(2026-10-02) ───────────────────────────────────────────
    //  문서 id = 작성자 appUserId(계정당 1번). 서버(announceFirstStar)만 쓰고 로그인 세션은 모두 읽는다
    //  (알림 화면에 "○○님이 세상에 첫 별을 남겼어요" 로 합쳐 보여 준다). 전체 공개 별만 들어온다.
    match /firstStars/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 서버 전용(rateLimits · abuseLog)을 포함해 위에 없는 경로는 모두 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
